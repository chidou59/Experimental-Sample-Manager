# 自动处理文本文件的换行符 (保证 Windows 和 Mac 都能正常看代码)
* text=auto

# ==========================
# 二进制文件标记
# ==========================
# 告诉 Git 这些是二进制文件，不要尝试去 diff (比较文本差异)
# 这样可以避免 Git 以为它们是乱码的文本文件

*.exe binary
*.dll binary
*.so binary
*.dylib binary

# 图片资源
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg text

# 文档资源
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary

# 字体
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary