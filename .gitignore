# === 1. Python 编译文件 (垃圾文件) ===
__pycache__/
*.py[cod]
*$py.class
*.so

# === 2. 打包与分发 (PyInstaller 生成的东西) ===
build/
dist/
*.spec
*.manifest
*.egg-info/
.eggs/

# === 3. 虚拟环境 (不要上传库文件) ===
.env
.venv
env/
venv/
lib/
lib64/

# === 4. PyCharm编辑器配置 (关键！必须忽略) ===
.idea/
# 同时也忽略 VS Code 的配置
.vscode/

# === 5. 项目特定文件 (保护你的隐私数据) ===
# 用户的本地路径配置文件
app_settings.json

# 如果你在项目里存放了大量的实验数据文件夹，建议也加在这里
# 例如你之前提到的:
My_Experiments_Data/
*_Data/

# === 6. 其他常见忽略 ===
# 操作系统缩略图
Thumbs.db
Desktop.ini
# Mac系统文件 (如果你发给用Mac的老师)
.DS_Store

# 覆盖率报告等
htmlcov/
.coverage
.pytest_cache/